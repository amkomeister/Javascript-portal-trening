# Production only. Set these as Cloud Run environment variables.
# This file is not loaded automatically. Never put credentials in VITE_*.
NODE_ENV=production
PORT=8080
APP_ORIGIN=https://YOUR-APP-DOMAIN
GOOGLE_CLOUD_PROJECT=YOUR-MUNICIPALITY-PROJECT
GOOGLE_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
ALLOWED_DOMAINS=YOUR-SCHOOL-DOMAIN
TEACHER_GOOGLE_SUBS=
# Use Cloud Run service identity / Application Default Credentials, not a key file.
# Do not set SCHOOL_LOCAL or FIRESTORE_EMULATOR_HOST in production.
